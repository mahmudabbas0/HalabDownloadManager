{
  "manifest_version": 3,
  "name": "Halab Download Manager",
  "version": "1.0.3",
  "author": "Mahmud Abbas",
  "description": "Send downloads to Halab Download Manager and show available public video formats.",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "storage",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "downloads.ui"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "links.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "minimum_chrome_version": "129",
  "web_accessible_resources": [
    {
      "resources": [
        "handoff.html",
        "handoff.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}