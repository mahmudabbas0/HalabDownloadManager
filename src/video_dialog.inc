 void videoDialog(){QDialog d(this);d.setWindowTitle("Video Downloader");d.resize(650,270);QVBoxLayout layout(&d);QLineEdit url;url.setPlaceholderText("https://www.youtube.com/watch?v=...");url.setLayoutDirection(Qt::LeftToRight);QPushButton lookup("Find available formats");QComboBox formats;QLabel note("Public video formats only. Protected streams are not supported.");note.setWordWrap(true);QPushButton download("Add video download");download.setEnabled(false);layout.addWidget(&url);layout.addWidget(&lookup);layout.addWidget(&formats);layout.addWidget(&note);layout.addWidget(&download);QProcess host;HalabTools::hidden(host);QByteArray response;QJsonArray choices;connect(&lookup,&QPushButton::clicked,&d,[&]{if(!HalabTools::validUrl(url.text()))return;formats.clear();choices={};response.clear();download.setEnabled(false);lookup.setEnabled(false);host.start(QCoreApplication::applicationDirPath()+"/HalabNativeHost.exe",QStringList{});if(!host.waitForStarted(3000)){note.setText("Desktop video connector is missing");lookup.setEnabled(true);return;}auto data=QJsonDocument(QJsonObject{{"op","formats"},{"url",url.text()}}).toJson(QJsonDocument::Compact);quint32 n=data.size();char head[4]={char(n),char(n>>8),char(n>>16),char(n>>24)};host.write(head,4);host.write(data);host.closeWriteChannel();});connect(&host,&QProcess::readyReadStandardOutput,&d,[&]{response+=host.readAllStandardOutput();});connect(&host,qOverload<int,QProcess::ExitStatus>(&QProcess::finished),&d,[&](int,QProcess::ExitStatus){lookup.setEnabled(true);response+=host.readAllStandardOutput();if(response.size()<4){note.setText("Could not read video formats");return;}auto reply=QJsonDocument::fromJson(response.mid(4)).object();if(!reply["ok"].toBool()){note.setText(reply["error"].toString());return;}choices=reply["formats"].toArray();for(auto value:choices){auto f=value.toObject();QString label=f["audioOnly"].toBool()?"Audio":QString::number(f["height"].toInt())+"p";label+=" · "+f["ext"].toString();if(f["needsMerge"].toBool())label+=" · video + audio";if(!f["available"].toBool())label+=" (requires FFmpeg)";formats.addItem(label);auto model=qobject_cast<QStandardItemModel*>(formats.model());if(model&&!f["available"].toBool())model->item(formats.count()-1)->setEnabled(false);}for(int i=choices.size()-1;i>=0;--i)if(choices[i].toObject()["available"].toBool()){formats.setCurrentIndex(i);download.setEnabled(true);break;}note.setText(reply["title"].toString());});connect(&download,&QPushButton::clicked,&d,[&]{int i=formats.currentIndex();if(i<0||i>=choices.size())return;auto f=choices[i].toObject();if(!f["available"].toBool())return;auto answer=receiveExternal({{"op","video"},{"url",url.text()},{"title",note.text()},{"formatId",f["id"]},{"needsMerge",f["needsMerge"]}});if(answer["ok"].toBool())d.accept();else note.setText(answer["error"].toString());});d.exec();if(host.state()!=QProcess::NotRunning){host.kill();host.waitForFinished(2000);}}
